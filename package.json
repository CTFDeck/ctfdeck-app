{
  "name": "ctfdeck-app",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "description": "CTFDeck Application",
  "author": "CTFDeck Contributors",
  "repository": "https://github.com/CTFDeck/ctfdeck-app",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"src/**/*.{ts,js,json,html,css}\"",
    "test": "ng test",
    "lint": "ng lint",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:start": "ng build --base-href ./ && npm run electron:build && electron .",
    "package": "electron-builder"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": ">=20.0.0 <22.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^0.0.1-alpha.564",
    "@types/jszip": "^3.4.0",
    "@types/morphdom": "^2.3.0",
    "ansi-to-html": "^0.7.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "3.3.2",
    "jszip": "^3.10.1",
    "lucide-angular": "^0.563.0",
    "marked": "^17.0.3",
    "morphdom": "^2.7.8",
    "ngx-sonner": ">=3.0.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.3.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@spartan-ng/cli": "^0.0.1-alpha.564",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/dompurify": "^3.0.5",
    "angular-eslint": "20.6.0",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.3",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.ctfdeck.app",
    "productName": "CTFDeck",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Development"
    }
  }
}
